{
  "name": "x-todo-corp",
  "version": "1.5.0",
  "description": "🚀 A modern, feature-rich task management application with Twitter/X-inspired design. Built with React, TypeScript, and Vite. Features include smart task management, notes, achievements, focus mode, and beautiful themes.",
  "main": "electron/main.cjs",
  "keywords": [
    "todo",
    "task-manager",
    "productivity",
    "react",
    "typescript",
    "vite",
    "pwa",
    "offline-first",
    "twitter-ui",
    "x-inspired",
    "electron"
  ],
  "homepage": "https://github.com/H3m0rv1ch1/x-to-do-corp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/H3m0rv1ch1/x-to-do-corp.git"
  },
  "bugs": {
    "url": "https://github.com/H3m0rv1ch1/x-to-do-corp/issues"
  },
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:start": "electron ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.xtodo.app",
    "productName": "X To-Do Corp",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icons/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "electron/icons/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "electron/icons"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
